<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#0B1020">
<LinearLayout android:id="@+id/root" android:orientation="vertical" android:paddingLeft="18dp" android:paddingRight="18dp" android:paddingTop="14dp" android:paddingBottom="28dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="SANCHES WiFi" android:textColor="#FFFFFF" android:textSize="27sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="ANALISADOR DE REDE • BAIXO CONSUMO" android:textColor="#8290AE" android:textSize="11sp" android:letterSpacing="0.08" android:layout_marginTop="2dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<LinearLayout android:orientation="horizontal" android:layout_marginTop="16dp" android:padding="16dp" android:background="@drawable/bg_card" android:layout_width="match_parent" android:layout_height="wrap_content"><LinearLayout android:orientation="vertical" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"><TextView android:text="REDE CONECTADA" android:textColor="#8290AE" android:textSize="10sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/><TextView android:id="@+id/ssid" android:text="Aguardando permissão…" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="5dp" android:maxLines="1" android:ellipsize="end" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:id="@+id/status" android:text="● MONITORAMENTO PAUSADO" android:textColor="#7F8CA8" android:textSize="11sp" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout><TextView android:id="@+id/signalBig" android:text="-- dBm" android:textColor="#63D6A2" android:textSize="21sp" android:textStyle="bold" android:gravity="center" android:layout_width="88dp" android:layout_height="60dp"/></LinearLayout>
<LinearLayout android:id="@+id/metrics" android:orientation="horizontal" android:weightSum="3" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:id="@+id/band" android:text="BANDA\n--" android:textColor="#DCE4F7" android:gravity="center" android:background="@drawable/bg_card" android:layout_marginRight="6dp" android:padding="12dp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="72dp"/>
<TextView android:id="@+id/channel" android:text="CANAL\n--" android:textColor="#DCE4F7" android:gravity="center" android:background="@drawable/bg_card" android:layout_marginHorizontal="3dp" android:padding="12dp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="72dp"/>
<TextView android:id="@+id/link" android:text="LINK\n--" android:textColor="#DCE4F7" android:gravity="center" android:background="@drawable/bg_card" android:layout_marginLeft="6dp" android:padding="12dp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="72dp"/>
</LinearLayout>
<LinearLayout android:orientation="horizontal" android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content"><Button android:id="@+id/scanButton" android:text="🔍  ESCANEAR REDES" android:textAllCaps="false" android:textColor="#FFFFFF" android:background="@drawable/bg_button" android:layout_weight="1" android:layout_width="0dp" android:layout_height="54dp"/><Button android:id="@+id/diagnoseButton" android:text="  DIAGNÓSTICO" android:textAllCaps="false" android:textColor="#DCE4F7" android:background="@drawable/bg_card" android:layout_marginLeft="8dp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="54dp"/></LinearLayout>
<TextView android:text="REDES PRÓXIMAS" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/scanInfo" android:text="Toque em escanear para atualizar" android:textColor="#8290AE" android:textSize="12sp" android:layout_marginTop="3dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<LinearLayout android:id="@+id/networks" android:orientation="vertical" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/footer" android:text="Monitoramento econômico: atualizações espaçadas para reduzir bateria.\nO Android pode limitar a frequência de varreduras Wi-Fi." android:textColor="#65728E" android:textSize="11sp" android:lineSpacingExtra="3dp" android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout></ScrollView>
